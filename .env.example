# App
# Used as the fallback origin for auth redirects outside a browser request.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local MVP demo smoke check
# ALEXANDRIA_DEMO_MCP_KEY is copied from the one-time MCP key creation page.
# ALEXANDRIA_DEMO_OAUTH_TOKEN is optional; when set, demo:check uses it instead
# of ALEXANDRIA_DEMO_MCP_KEY for the MCP bearer smoke path.
# ALEXANDRIA_DEMO_COOKIE is optional; set it to the browser Cookie header for
# full signed-in workspace/memories page verification in npm run demo:check.
ALEXANDRIA_DEMO_BASE_URL=http://localhost:3000
ALEXANDRIA_DEMO_MCP_KEY=
ALEXANDRIA_DEMO_OAUTH_TOKEN=
ALEXANDRIA_DEMO_WORKSPACE_SLUG=
ALEXANDRIA_DEMO_COOKIE=
ALEXANDRIA_DEMO_POLL_SECONDS=90

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT with role claim "mcp_session_executor"; used only after MCP key verification
# so memory_save tenant writes run under RLS instead of service_role.
# Local generation: SUPABASE_JWT_SECRET='<jwt secret>' npm run local:mcp-jwt
SUPABASE_MCP_EXECUTOR_JWT=

# Local Supabase CLI Google OAuth provider placeholders.
# Leave blank unless testing Google locally; export these in the shell before
# running `supabase start` or `supabase db reset` if the local config enables
# [auth.external.google].
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Inngest
# memory_save enqueues memory/process.requested; /api/inngest serves
# the memory-process-v1 classify/embed/conflict/finalize worker.
# For Mike-test/prod demos before Inngest Cloud keys exist, set this true to
# process the just-saved memory inline instead of enqueueing it.
ALEXANDRIA_PROCESS_MEMORY_INLINE=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Classifier
# Basic workspaces use ANTHROPIC_BASIC_CLASSIFIER_MODEL when set.
# Pro workspaces use ANTHROPIC_PRO_CLASSIFIER_MODEL when set.
# ANTHROPIC_CLASSIFIER_MODEL is the shared fallback model override.
# Without ANTHROPIC_API_KEY, local/test runs use the deterministic classifier.
# Provider failures route the memory to conflict review as kind=unknown.
# Classifier confidence <= 0.6 preserves kind/confidence but suppresses
# auto-resolution and leaves the memory in conflict review.
ANTHROPIC_API_KEY=
ANTHROPIC_CLASSIFIER_MODEL=
ANTHROPIC_BASIC_CLASSIFIER_MODEL=
ANTHROPIC_PRO_CLASSIFIER_MODEL=

# Embeddings
# Basic workspaces use OpenAI embeddings. Pro workspaces use Voyage when
# VOYAGE_API_KEY is configured, otherwise they fall back to OpenAI/deterministic.
# Provider failures mark the memory failed with processing metadata.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=
