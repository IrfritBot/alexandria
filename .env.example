# App
# Used as the fallback origin for auth redirects outside a browser request.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT with role claim "mcp_session_executor"; used only after MCP key verification
# so memory_save tenant writes run under RLS instead of service_role.
SUPABASE_MCP_EXECUTOR_JWT=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Model providers for future worker integration
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
